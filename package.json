{
  "name": "@dev-build-deploy/sarif-it",
  "version": "0.1.0",
  "description": "Static Analysis Results Interchange Format Builder Library",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc --project tsconfig.publish.json",
    "test": "jest --coverage",
    "lint": "eslint --ext .ts .",
    "format": "prettier --write **/*.ts && prettier --write **/*.ts",
    "prepare": "node -e \"if(process.env.CI)process.exit(0);const r=require('child_process').spawnSync('pre-commit',['install','--hook-type','pre-commit','--hook-type','commit-msg'],{stdio:'inherit'});if(r.error)console.log('hint: install pre-commit (https://pre-commit.com) to get the git hooks')\""
  },
  "author": "Kevin de Jong",
  "license": "MIT",
  "keywords": [
    "SARIF",
    "Code Quality"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-build-deploy/sarif-it.git"
  },
  "bugs": {
    "url": "https://github.com/dev-build-deploy/sarif-it/issues"
  },
  "homepage": "https://github.com/dev-build-deploy/sarif-it#readme",
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  },
  "files": [
    "lib/*"
  ],
  "dependencies": {
    "@types/sarif": "^2.1.4"
  }
}
